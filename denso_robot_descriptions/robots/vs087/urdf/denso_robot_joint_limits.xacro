<?xml version='1.0' encoding='UTF-8'?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
	<xacro:macro name="denso_robot_control_limits" params="namespace">
		<joint name="$(arg namespace)joint_1">
			<command_interface name="position">
				<param name="min">-2.967060</param>
				<param name="max">2.967060</param>
			</command_interface>
			<command_interface name="velocity">
				<param name="min">0</param>
				<param name="max">0.2633</param>
			</command_interface>
			<state_interface name="position"/>
			<state_interface name="velocity"/>
			<state_interface name="effort"/>
		</joint>
		<joint name="$(arg namespace)joint_2">
			<command_interface name="position">
				<param name="min">-1.74533</param>
				<param name="max">2.35619</param>
			</command_interface>
			<command_interface name="velocity">
				<param name="min">0</param>
				<param name="max">0.2333</param>
			</command_interface>
			<state_interface name="position"/>
			<state_interface name="velocity"/>
			<state_interface name="effort"/>
		</joint>
		<joint name="$(arg namespace)joint_3">
			<command_interface name="position">
				<param name="min">-2.37365</param>
				<param name="max">2.67035</param>
			</command_interface>
			<command_interface name="velocity">
				<param name="min">0</param>
				<param name="max">0.27997</param>
			</command_interface>
			<state_interface name="position"/>
			<state_interface name="velocity"/>
			<state_interface name="effort"/>
		</joint>
		<joint name="$(arg namespace)joint_4">
			<command_interface name="position">
				<param name="min">-4.71239</param>
				<param name="max">4.71239</param>
			</command_interface>
			<command_interface name="velocity">
				<param name="min">0</param>
				<param name="max">0.34996</param>
			</command_interface>
			<state_interface name="position"/>
			<state_interface name="velocity"/>
			<state_interface name="effort"/>
		</joint>
		<joint name="$(arg namespace)joint_5">
			<command_interface name="position">
				<param name="min">-2.0944</param>
				<param name="max">2.0944</param>
			</command_interface>
			<command_interface name="velocity">
				<param name="min">0</param>
				<param name="max">0.34996</param>
			</command_interface>
			<state_interface name="position"/>
			<state_interface name="velocity"/>
			<state_interface name="effort"/>
		</joint>
		<joint name="$(arg namespace)joint_6">
			<command_interface name="position">
				<param name="min">-6.28319</param>
				<param name="max">6.28319</param>
			</command_interface>
			<command_interface name="velocity">
				<param name="min">0</param>
				<param name="max">0.55994</param>
			</command_interface>
			<state_interface name="position"/>
			<state_interface name="velocity"/>
			<state_interface name="effort"/>
		</joint>
	</xacro:macro>
</robot>